{
  "schema_version": "plugin-dependency-graph-v0.1",
  "plugins": [
    {
      "plugin_id": "submitted-search",
      "surface": "submitted_search",
      "version": "0.1.0",
      "description": "Fetches submitted search result pages for each query and records access, response, timing, and limitation evidence.",
      "depends_on": [],
      "consumes": [
        "site_profile",
        "query_pack",
        "shopify_adapter"
      ],
      "produces": [
        "submitted_search_evidence"
      ],
      "cache": {
        "enabled": false
      }
    },
    {
      "plugin_id": "autocomplete",
      "surface": "autocomplete",
      "version": "0.1.0",
      "description": "Fetches Shopify suggest endpoint responses for each query and records suggested products, collections, queries, pages, timing, and limitation evidence.",
      "depends_on": [],
      "consumes": [
        "site_profile",
        "query_pack",
        "shopify_adapter"
      ],
      "produces": [
        "autocomplete_evidence"
      ],
      "cache": {
        "enabled": false
      }
    },
    {
      "plugin_id": "facets",
      "surface": "facets",
      "version": "0.1.0",
      "description": "Fetches collection pages and records observable facet/filter markup presence, filter parameter probe responses, and limitation evidence.",
      "depends_on": [],
      "consumes": [
        "site_profile",
        "shopify_adapter"
      ],
      "produces": [
        "facet_evidence"
      ],
      "cache": {
        "enabled": false
      }
    },
    {
      "plugin_id": "recommendations",
      "surface": "recommendations",
      "version": "0.1.0",
      "description": "Fetches the public Shopify product recommendations endpoint for sampled products and records returned products, timing, and limitation evidence.",
      "depends_on": [],
      "consumes": [
        "site_profile",
        "shopify_adapter"
      ],
      "produces": [
        "recommendations_evidence"
      ],
      "cache": {
        "enabled": false
      }
    },
    {
      "plugin_id": "mobile",
      "surface": "mobile",
      "version": "0.1.0",
      "description": "Fetches the homepage and a search page with a mobile user agent and records response, viewport meta presence, and limitation evidence. HTTP-level only; rendered mobile capture remains a platform capability gap.",
      "depends_on": [],
      "consumes": [
        "site_profile",
        "query_pack",
        "shopify_adapter"
      ],
      "produces": [
        "mobile_evidence"
      ],
      "cache": {
        "enabled": false
      }
    },
    {
      "plugin_id": "competitor-inspection",
      "surface": "competitor_inspection",
      "version": "0.1.0",
      "description": "Runs the same bounded query probes (submitted search and suggest) against peer target manifests listed in the evaluation manifest and records observational same-query evidence. Comparative framing stays downstream.",
      "depends_on": [],
      "consumes": [
        "evaluation_manifest",
        "query_pack",
        "shopify_adapter"
      ],
      "produces": [
        "competitor_same_query_evidence"
      ],
      "cache": {
        "enabled": false
      }
    }
  ],
