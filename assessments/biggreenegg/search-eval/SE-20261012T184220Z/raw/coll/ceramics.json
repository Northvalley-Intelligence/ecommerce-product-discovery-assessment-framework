{"products":[{"id":9654625829166,"title":"Flat Pizza \u0026 Baking Stone (Diameter 14 in \/ 36cm) (for XXL, XL, L)","handle":"flat-pizza-baking-stone-diameter-14-in-36cm-for-xxl-xl-l","body_html":"\u003cp\u003ePizza, sourdough bread, focaccia, or a delicious apple pie: with the Baking Stone, you can open your own bakery at home. Place the stone on the grid in the Big Green Egg and bake bread with a crispy crust and pizzas with a crunchy base.\u003c\/p\u003e\n\u003cp\u003eThe Baking Stone is one of the favorite accessories among EGG users. Place the pizza stone directly on the grid (in combination with the convEGGtor) when you light the EGG, so that it warms up gradually. As the Baking Stone retains heat well, you can easily keep pizzas and cakes warm before serving them (but of course, there's a high risk they'll be gone in no time).\u003c\/p\u003e\n\u003cp\u003e \u003c\/p\u003e","published_at":"2024-11-18T09:59:11-05:00","created_at":"2024-11-18T09:59:12-05:00","updated_at":"2026-10-12T14:42:48-04:00","vendor":"Big Green Egg","product_type":"Outdoor Grill Replacement Parts","tags":["BS","Small-From DC"],"variants":[{"id":49590071132462,"title":"14 in","option1":"14 in","option2":"Default Title","option3":null,"sku":"401014","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"49.99","grams":3402,"compare_at_price":null,"position":1,"product_id":9654625829166,"created_at":"2024-11-18T09:59:12-05:00","updated_at":"2026-10-12T14:42:48-04:00"}],"images":[{"id":49796763124014,"created_at":"2025-04-08T11:44:29-04:00","position":1,"updated_at":"2025-04-08T11:44:30-04:00","product_id":9654625829166,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0901\/1465\/4510\/files\/optimized_baking-stone-800x500-1_48130954-53c5-4b5a-b599-5aab09c4e57a.png?v=1744127070","width":1200,"height":750}],"options":[{"name":"Size","position":1,"values":["12 in","14 in","18 in"]}]},{"id":9654624289070,"title":"convEGGtor® for Large EGG","handle"