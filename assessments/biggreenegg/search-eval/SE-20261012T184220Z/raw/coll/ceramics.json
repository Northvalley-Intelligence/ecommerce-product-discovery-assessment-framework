l=\"noopener\" href=\"https:\/\/shop.biggreenegg.com\/recipe_types\/pizza-calzones\/\" target=\"_blank\"\u003eRecipes\u003c\/a\u003e\u003cspan\u003e \u003c\/span\u003eare wonderful to use with the Half Moon Baking Stone.\u003c\/div\u003e","published_at":"2024-11-18T09:59:05-05:00","created_at":"2024-11-18T09:59:05-05:00","updated_at":"2026-10-12T14:42:48-04:00","vendor":"Big Green Egg","product_type":"Outdoor Grill Racks \u0026 Toppers","tags":["Small-From DC","YBlocklist"],"variants":[{"id":49590069756206,"title":"M","option1":"M","option2":"Default Title","option3":null,"sku":"127273","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"29.99","grams":1361,"compare_at_price":null,"position":1,"product_id":9654625501486,"created_at":"2024-11-18T09:59:05-05:00","updated_at":"2026-10-12T14:42:48-04:00"}],"images":[{"id":49688690164014,"created_at":"2025-03-26T11:54:20-04:00","position":1,"updated_at":"2025-03-26T11:54:22-04:00","product_id":9654625501486,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0901\/1465\/4510\/files\/Half-Moon-ConvEGGtor-1-_1.png?v=1743004462","width":2048,"height":2048}],"options":[{"name":"Fits Egg Size","position":1,"values":["2XL","M","XL"]}]},{"id":9654625141038,"title":"Half Moon convEGGtor for 2XL","handle":"half-moon-conveggtor-for-2xl","body_html":"\u003cp\u003eIncredibly versatile is an understatement when it comes to the Half convEGGtor Stone. Use it together with the 1-piece convEGGtor basket as an intermediate layer when you want to cook in two zones, one for direct heat and one for indirect heat. Or as a full convection shield when two are placed against each other.\u003c\/p\u003e\n\u003cp\u003eDesigned to be a \"burn-free zone stone\" when the two are combined, maximizing cooking surface. With a convEGGtor, the smaller diameter means food around the edges can burn. So it's perfect for cooking large volumes at lower temperatures, like chicken wings. When using one half for two-zone cooking, you have the other half left where you can cook without worrying about burning.\u003c\/p\u003e\n\u003cp\u003eThe Half convEGGtor Stone is made of Big Green Egg ceramic.\u003c\/p\u003e\n\u003cp\u003eNote: When using the 5-piece EGGspander Kit, only 1 Half convEGGtor Stone fits the middle level due to its size.\u003c\/p\u003e\n\u003cp\u003e \u003c\/p\u003e","published_at":"2024-11-18T09:58:56-05:00","created_at":"2024-11-18T09:58:57-05:00","updated_at":"2026-10-12T14:42:48-04:00","vendor":"Big Green Egg","product_type":"Outdoor Grill Racks \u0026 Toppers","tags":["Small-From DC","YBlocklist"],"variants":[{"id":49590067986734,"title":"2XL","option1":"2XL","option2":"Default Title","option3":null,"sku":"120960","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"99.99","grams":5670,"compare_at_price":null,"position":1,"product_id":9654625141038,"created_at":"2024-11-18T09:58:57-05:00","updated_at":"2026-10-12T14:42:48-04:00"}],"images":[{"id":49796751851822,"created_at":"2025-04-08T11:43:03-04:00","position":1,"updated_at":"2025-04-08T11:43:05-04:00","product_id":9654625141038,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0901\/1465\/4510\/files\/optimized_half-conveggtor-stone-800x500-1_725764e3-4e89-4bda-bdf2-128f9afabc9d.png?v=1744126985","width":1200,"height":750}],"options":[{"name":"Fits Egg Size","position":1,"values":["2XL","M","XL"]}]},{"id":9654625272110,"title":"Half Moon convEGGtor for XL","handle":"half-moon-conveggtor-for-xl","body_html":"\u003cp\u003eIncredibly versatile is an understatement when it comes to the Half convEGGtor Stone. Use it together with the 1-piece convEGGtor basket as an intermediate layer when you want to cook in two zones, one for direct heat and one for indirect heat. Or as a full convection shield when two are placed against each other.\u003c\/p\u003e\n\u003cp\u003eDesigned to be a \"burn-free zone stone\" when the two are combined, maximizing cooking surface. With